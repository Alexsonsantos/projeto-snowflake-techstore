-- =============================================================

-- Criação e configuração do Virtual Warehouse (Computação)
CREATE OR REPLACE WAREHOUSE TECHSTORE_WH
    WITH WAREHOUSE_SIZE = 'XSMALL'
    AUTO_SUSPEND = 60
    AUTO_RESUME = TRUE
    INITIALLY_SUSPENDED = TRUE
    COMMENT = 'Warehouse para cargas e analises da TechStore';

USE WAREHOUSE TECHSTORE_WH;

-- Criação do Banco de Dados e Schema
CREATE OR REPLACE DATABASE TECHSTORE_DB;
USE DATABASE TECHSTORE_DB;

CREATE OR REPLACE SCHEMA VENDAS;
USE SCHEMA TECHSTORE_DB.VENDAS;

-- Criação da Tabela de Clientes (com campo VARIANT para dados JSON)
CREATE OR REPLACE TABLE CLIENTES (
    CLIENTE_ID INT AUTOINCREMENT START 1 INCREMENT 1 PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(150) UNIQUE,
    ESTADO VARCHAR(2),
    METADADOS VARIANT, -- Grava atributos flexiveis no formato JSON
    DATA_CADASTRO TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

-- Criação da Tabela de Produtos
CREATE OR REPLACE TABLE PRODUTOS (
    PRODUTO_ID INT PRIMARY KEY,
    NOME_PRODUTO VARCHAR(100) NOT NULL,
    CATEGORIA VARCHAR(50),
    PRECO NUMBER(10,2) NOT NULL,
    ESTOQUE INT DEFAULT 0
);

-- Criação da Tabela de Vendas
CREATE OR REPLACE TABLE VENDAS (
    VENDA_ID INT AUTOINCREMENT PRIMARY KEY,
    CLIENTE_ID INT REFERENCES CLIENTES(CLIENTE_ID),
    DATA_VENDA TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    VALOR_TOTAL NUMBER(10,2),
    STATUS VARCHAR(20) DEFAULT 'CONCLUIDA'
);

-- Criação da Tabela de Itens da Venda
CREATE OR REPLACE TABLE ITENS_VENDA (
    ITEM_ID INT AUTOINCREMENT PRIMARY KEY,
    VENDA_ID INT REFERENCES VENDAS(VENDA_ID),
    PRODUTO_ID INT REFERENCES PRODUTOS(PRODUTO_ID),
    QUANTIDADE INT NOT NULL,
    PRECO_UNITARIO NUMBER(10,2) NOT NULL
);




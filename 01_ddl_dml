-- MERGE INTO: Carga Incremental / Upsert

-- Criando uma tabela staging temporária para simular chegada de novos dados
CREATE OR REPLACE TEMP TABLE STG_PRODUTOS (
    PRODUTO_ID INT,
    NOME_PRODUTO VARCHAR(100),
    CATEGORIA VARCHAR(50),
    PRECO NUMBER(10,2),
    ESTOQUE INT
);

INSERT INTO STG_PRODUTOS VALUES
(102, 'Teclado Mecanico RGB v2', 'Acessórios', 380.00, 40), -- Atualiza ID 102
(105, 'Webcam Full HD 1080p', 'Vídeo', 190.00, 25);            -- Insere novo ID 105

-- Executando a operação de MERGE
MERGE INTO PRODUTOS p
USING STG_PRODUTOS s
ON p.PRODUTO_ID = s.PRODUTO_ID
WHEN MATCHED THEN
    UPDATE SET 
        p.NOME_PRODUTO = s.NOME_PRODUTO,
        p.PRECO = s.PRECO,
        p.ESTOQUE = s.ESTOQUE
WHEN NOT MATCHED THEN
    INSERT (PRODUTO_ID, NOME_PRODUTO, CATEGORIA, PRECO, ESTOQUE)
    VALUES (s.PRODUTO_ID, s.NOME_PRODUTO, s.CATEGORIA, s.PRECO, s.ESTOQUE);

-- DELETE: Exclusão de Registros
-- Remover registros de testes ou pedidos cancelados (exemplo)
DELETE FROM VENDAS 
WHERE STATUS = 'CANCELADA' OR VALOR_TOTAL <= 0;



-- Relatório de Vendas JOIN simples
SELECT 
    c.NOME AS NOME_CLIENTE,
    v.VENDA_ID,
    v.DATA_VENDA,
    v.VALOR_TOTAL
FROM VENDAS v
JOIN CLIENTES c ON v.CLIENTE_ID = c.CLIENTE_ID;

-- Notação de ponto (:) e coerção de tipo (::STRING) para JSON no Snowflake
SELECT 
    NOME,
    METADADOS:canal_origem::STRING AS CANAL_ORIGEM,
    METADADOS:categoria_fav::STRING AS CATEGORIA_FAVORITA
FROM CLIENTES;


-- Criando as Roles
USE ROLE USERADMIN;

CREATE ROLE IF NOT EXISTS ROLE_ANALISTA_BI
    COMMENT = 'Acesso de apenas leitura as tabelas de Vendas';

CREATE ROLE IF NOT EXISTS ROLE_ENGENHEIRO_DADOS
    COMMENT = 'Acesso de leitura e escrita para pipelines de dados';

-- Estabelecendo a hierarquia
GRANT ROLE ROLE_ANALISTA_BI TO ROLE ROLE_ENGENHEIRO_DADOS;
GRANT ROLE ROLE_ENGENHEIRO_DADOS TO ROLE SYSADMIN;


-- =============================================================
-- Acessos de Computação e Objetos (SYSADMIN)
-- =============================================================
USE ROLE SYSADMIN;

-- Permissões de infraestrutura
GRANT USAGE ON WAREHOUSE TECHSTORE_WH TO ROLE ROLE_ANALISTA_BI;
GRANT USAGE ON DATABASE TECHSTORE_DB TO ROLE ROLE_ANALISTA_BI;
GRANT USAGE ON SCHEMA TECHSTORE_DB.VENDAS TO ROLE ROLE_ANALISTA_BI;

-- Permissões de leitura (Analista)
GRANT SELECT ON ALL TABLES IN SCHEMA TECHSTORE_DB.VENDAS TO ROLE ROLE_ANALISTA_BI;
GRANT SELECT ON FUTURE TABLES IN SCHEMA TECHSTORE_DB.VENDAS TO ROLE ROLE_ANALISTA_BI;

-- Permissões de escrita (Engenheiro)
GRANT INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA TECHSTORE_DB.VENDAS TO ROLE ROLE_ENGENHEIRO_DADOS;
GRANT INSERT, UPDATE, DELETE ON FUTURE TABLES IN SCHEMA TECHSTORE_DB.VENDAS TO ROLE ROLE_ENGENHEIRO_DADOS;


